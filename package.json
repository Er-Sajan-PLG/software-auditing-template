{
  "name": "@xenos1996/usa",
  "version": "2.0.0",
  "description": "Universal Software Auditor — an open-source, self-adapting audit framework for any project, any stack, any stage",
  "license": "MIT",
  "type": "module",
  "bin": {
    "usa": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": "./rules/index.yaml"
  },
  "files": [
    "dist",
    "rules",
    "templates",
    "schema",
    "docs",
    "USA.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "audit",
    "software-audit",
    "security-audit",
    "code-audit",
    "code-review",
    "openssf",
    "owasp-asvs",
    "slsa",
    "sast",
    "agent",
    "llm",
    "template",
    "tech-debt",
    "quality-gate"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Er-Sajan-PLG/universal-software-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/Er-Sajan-PLG/universal-software-auditor/issues"
  },
  "homepage": "https://github.com/Er-Sajan-PLG/universal-software-auditor#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "usa": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "self-audit": "npm run build && node dist/cli.js audit . --out AUDIT.md",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.0"
  }
}
